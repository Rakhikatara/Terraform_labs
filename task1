
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}
provider "aws" {
  region = "ap-south-1"
}
# Find available Availability Zones in Mumbai
data "aws_availability_zones" "available" {
  state = "available"
}
# Find the latest Amazon Linux 2023 AMI
data "aws_ami" "amazon_linux" {
  most_recent = true
  owners      = ["amazon"]
  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-kernel-*-x86_64"]
  }
  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}
# Create VPC
resource "aws_vpc" "lab_vpc" {
  cidr_block           = "10.0.0.0/16"
  enable_dns_support   = true
  enable_dns_hostnames = true
  tags = {
    Name = "terraform-lab-vpc"
  }
  # Protect the VPC from Terraform destruction
  lifecycle {
    prevent_destroy = true
  }
}
# Create two subnets in different Availability Zones
resource "aws_subnet" "lab_subnet" {
  count = 2
  vpc_id                  = aws_vpc.lab_vpc.id
  cidr_block              = "10.0.${count.index + 1}.0/24"
  availability_zone       = data.aws_availability_zones.available.names[count.index]
  map_public_ip_on_launch = false
  tags = {
    Name = count.index == 0 ? "SUBNET-A" : "SUBNET-B"
  }
}
# Security group: no inbound access
resource "aws_security_group" "lab_sg" {
  name        = "terraform-lab-sg"
  description = "Restricted security group for Terraform lab"
  vpc_id      = aws_vpc.lab_vpc.id
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = {
    Name = "terraform-lab-sg"
  }
}
# Create two EC2 instances, one in each subnet
resource "aws_instance" "lab_ec2" {
  count = 2
  ami                         = data.aws_ami.amazon_linux.id
  instance_type               = "t3.micro"
  subnet_id                   = aws_subnet.lab_subnet[count.index].id
  vpc_security_group_ids      = [aws_security_group.lab_sg.id]
  associate_public_ip_address = false
  tags = {
    Name = "terraform-lab-ec2-${count.index + 1}"
  }
  # Ignore manual changes to EC2 tags
  lifecycle {
    ignore_changes = [tags]
  }
}
# Display useful information after creation
output "vpc_id" {
  value = aws_vpc.lab_vpc.id
}
output "subnet_ids" {
  value = aws_subnet.lab_subnet[*].id
}
output "ec2_instance_ids" {
  value = aws_instance.lab_ec2[*].id
}
output "availability_zones" {
  value = aws_subnet.lab_subnet[*].availability_zone
}
